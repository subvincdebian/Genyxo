# ==============================================================
# Genyxo Platform Environment Configuration Template
# Copy this file to .env and replace placeholder values
# ==============================================================

# Application Runtime
NODE_ENV=production
PORT=3000
SITE_URL=https://genyxo.com
ALLOWED_ORIGINS=https://genyxo.com,http://localhost:3000,http://localhost:3001

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
WEBHOOK_SECRET=replace_with_webhook_secret

# OAuth Integrations (Optional / Provider-specific)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# SMTP Mailer (Zoho / Custom SMTP)
ZOHO_APP_PASSWORD=your_zoho_smtp_password

# Payment Gateways (NOWPayments / Stripe)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_IPN_URL=https://genyxo.com/payment/webhook
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1/invoice
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook

# AI Model Integrations
OPENAI_API_KEY=sk-proj-your_openai_key
FAL_KEY=your_fal_ai_key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
GOOGLE_API_KEY=your_gemini_api_key

# --------------------------------------------------------------
# Database Configuration
# In Docker Compose, the internal hostname is 'mysql'
# --------------------------------------------------------------
MYSQLHOST=mysql
MYSQLPORT=3306
MYSQLUSER=genyxo_user
MYSQLPASSWORD=genyxo_secure_pass
MYSQLDATABASE=genyxo
MYSQL_ROOT_PASSWORD=root_super_secure_password
DB_LOGGING=false

# Optional Cloud DB (TiDB Cloud)
# MYSQL_TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# MYSQL_TIDB_PORT=4000
# MYSQL_TIDB_USERNAME=root
# MYSQL_TIDB_PASSWORD=password
# MYSQL_TIDB_DATABASE=genyxo

# --------------------------------------------------------------
# Redis Cache & Sessions
# In Docker Compose, the internal hostname is 'redis'
# --------------------------------------------------------------
REDISHOST=redis
REDISPORT=6379
REDISPASSWORD=redis_secure_pass

# Optional External Redis (Upstash)
# REDIS_URL=rediss://default:token@cluster.upstash.io:6379
