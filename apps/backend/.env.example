# ==============================================================
# Genyxo Platform Environment Configuration Template
# Copy this file to .env and replace placeholder values
# ==============================================================

# Application Runtime
NODE_ENV=production
PORT=3000
SITE_URL=https://genyxo.com
# Public Next.js address. For local development: http://localhost:3001
# SITE_URL remains the externally reachable backend webhook address.
FRONTEND_URL=https://genyxo.com
ALLOWED_ORIGINS=https://genyxo.com,http://localhost:3000,http://localhost:3001

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
WEBHOOK_SECRET=replace_with_webhook_secret

# OAuth Integrations (Optional / Provider-specific)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
# Must match the URLs registered with the providers. Next proxies /auth/*.
GOOGLE_CALLBACK_URL=https://genyxo.com/auth/google/callback
FACEBOOK_CALLBACK_URL=https://genyxo.com/auth/facebook/callback

# SMTP Mailer (Zoho / Custom SMTP)
ZOHO_APP_PASSWORD=your_zoho_smtp_password

# Payment Gateways (NOWPayments / Stripe)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_IPN_URL=https://genyxo.com/payment/webhook
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1/invoice
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook

# AI Model Integrations
OPENAI_API_KEY=sk-proj-your_openai_key
FAL_KEY=your_fal_ai_key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
GOOGLE_API_KEY=your_gemini_api_key

# --------------------------------------------------------------
# Database Configuration
# In Docker Compose, the internal hostname is 'mysql'
# --------------------------------------------------------------
MYSQLHOST=mysql
MYSQLPORT=3306
MYSQLUSER=genyxo_user
MYSQLPASSWORD=genyxo_secure_pass
MYSQLDATABASE=genyxo
MYSQL_ROOT_PASSWORD=root_super_secure_password
DB_LOGGING=false

# Optional Cloud DB (TiDB Cloud)
# MYSQL_TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# MYSQL_TIDB_PORT=4000
# MYSQL_TIDB_USERNAME=root
# MYSQL_TIDB_PASSWORD=password
# MYSQL_TIDB_DATABASE=genyxo

# --------------------------------------------------------------
# Redis Cache & Sessions
# In Docker Compose, the internal hostname is 'redis'
# --------------------------------------------------------------
REDISHOST=redis
REDISPORT=6379
REDISPASSWORD=redis_secure_pass

# Optional External Redis (Upstash)
# REDIS_URL=rediss://default:token@cluster.upstash.io:6379

# --------------------------------------------------------------
# Observability & Telemetry (OpenTelemetry, Prometheus, Sentry)
# --------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=genyxo-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info

# Workspace title jobs reuse OPENROUTER_API_KEY; fixed output budget: 20 tokens.
CHAT_TITLE_MODEL=openai/gpt-4o-mini
# Optional 32-byte hex key for private plugin credentials. Generate and store
# outside source control; leave unset to disable saving credentials.
WORKSPACE_ENCRYPTION_KEY=

# ---------- Plugins (apps/backend/src/integrations) ----------
# Linked-account tokens are AES-256-GCM encrypted with this 32-byte hex key
# (falls back to WORKSPACE_ENCRYPTION_KEY). Generate: openssl rand -hex 32
# Changing it disconnects every plugin.
INTEGRATIONS_ENCRYPTION_KEY=
# Public origin the browser uses; OAuth redirect URIs are
# <this>/api/integrations/<provider>/callback. Defaults to FRONTEND_URL.
INTEGRATIONS_PUBLIC_URL=http://localhost:3001
# A provider without both values shows "Not configured" on the Plugins page.
# GitHub: github.com/settings/developers → OAuth Apps → New OAuth App.
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
# Google (Gmail, Drive, Calendar): console.cloud.google.com/apis/credentials →
# OAuth client ID (Web application). Enable the Gmail, Drive and Calendar APIs.
# Empty values fall back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (sign-in).
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=
# Microsoft (Outlook mail and calendar, Teams): entra.microsoft.com → App
# registrations → New registration (Web platform), then Certificates & secrets.
MICROSOFT_INTEGRATION_CLIENT_ID=
MICROSOFT_INTEGRATION_CLIENT_SECRET=
# "common" for work and personal accounts, or your tenant id.
MICROSOFT_INTEGRATION_TENANT=common
# Zoom: marketplace.zoom.us → Develop → Build App → General App (user-managed).
# Register http://127.0.0.1:3001/api/integrations/zoom/callback (Zoom rejects
# "localhost" with error 4700) as the redirect URL and in the OAuth allow list.
ZOOM_INTEGRATION_CLIENT_ID=
ZOOM_INTEGRATION_CLIENT_SECRET=
# Spotify: developer.spotify.com/dashboard → Create app (Web API). Register
# http://127.0.0.1:3001/api/integrations/spotify/callback (Spotify rejects
# "localhost"; Genyxo sends 127.0.0.1 and hands the callback back automatically).
SPOTIFY_INTEGRATION_CLIENT_ID=
SPOTIFY_INTEGRATION_CLIENT_SECRET=
# LinkedIn: linkedin.com/developers/apps → Create app, then add the products
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
LINKEDIN_INTEGRATION_CLIENT_ID=
LINKEDIN_INTEGRATION_CLIENT_SECRET=
# Apple Music catalog (developer token): developer.apple.com → Keys → a key with
# MusicKit. PRIVATE_KEY is the .p8 file content on one line, with \n for breaks.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# No keys needed for the rest:
# - MCP plugins (Linear, Atlassian, Stripe, PayPal, Notion, Figma, Canva, Dropbox,
#   Supabase, Vercel, Netlify, Railway, GitLab, Wix, WordPress.com, Kahoot!,
#   Lovable, Namecheap, CoinMarketCap, Mobbin, Higgsfield) register Genyxo as an
#   OAuth client automatically at /api/integrations/mcp/callback.
# - Render, Shopify, MongoDB Atlas and Tripo: each user pastes their own key.
# - Stack Overflow, Binance, Bybit, Malwarebytes, Xmind and Superpowers need no account.


# Voice conversation (Gemini, uses GOOGLE_API_KEY)
VOICE_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
VOICE_TTS_MODEL=gemini-3.8-flash-lite-tts
VOICE_TTS_VOICE=Kore
# Gemini Live model for real-time voice calls (audio in, audio out).
VOICE_LIVE_MODEL=gemini-3.8-live

# Media tools every chat model can call (apps/backend/src/chat/media).
# Each kind tries the Gemini API (GOOGLE_API_KEY) first and falls back to the
# same Google models on fal.ai (FAL_KEY, fal.ai/dashboard/keys) when the Gemini
# key has no quota. Free-tier Gemini keys cover speech only; images and music
# need a paid Gemini tier or fal.ai. Video always uses fal.ai.
# Credits charged per success: image 40, video 400 (refunded if it fails),
# music 60, speech free (MEDIA_COSTS in media.service.ts).
# fal.ai prices: image ~$0.04, 8 s video with sound ~$1.20, 30 s music ~$0.10.
MEDIA_IMAGE_MODEL=gemini-3.1-flash-image
MEDIA_MUSIC_MODEL=lyria-3-clip-preview
MEDIA_VIDEO_MODEL=fal-ai/veo3.1/fast
